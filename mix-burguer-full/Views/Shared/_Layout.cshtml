                </div>
            </div>
            <div class="d-flex align-items-center gap-3">
                <div class="mb-busca d-flex align-items-center px-2 py-1 rounded gap-3">
                    <i class="bi bi-search me-2 text-white"></i>
                    <input id="inputBuscar" onkeyup="buscarLanche()" type="text" class="border-0 shadow-none mb-input-busca" placeholder="Pesquise seu lanche...">
                </div>
                <i class="bi bi-person-fill mb-icon-person" onclick="btnPerfil()"></i>
