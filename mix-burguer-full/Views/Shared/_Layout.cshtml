    @if (layoutType == "A")
    {
        <header class="sticky-top bg-mix shadow-sm py-4 px-5 d-flex justify-content-between align-items-center">
            <div class="d-flex align-items-center gap-4 position-relative header-mix">
                <a asp-action="Index">
                    <img src="~/IMGS/Logo.png" alt="Logo" class="mb-header-logo" />
                </a>
                <div class="ms-text-mix">
                    <h1 class="title h2 fw-bold text-dark">Mix Burguer</h1>
                    <h2 class="caption h5 fw-semibold text-dark mt-n2">Hamburgueria</h2>
                </div>
            </div>
            <div class="d-flex align-items-center gap-3">
                <i class="bi bi-person-fill mb-icon-person" onclick="btnPerfil()"></i>
                <i class="bi bi-bag-fill mb-icon-bag" onclick="btnSacola()"></i>
            </div>
        </header>
    }
    else if (layoutType == "B")
