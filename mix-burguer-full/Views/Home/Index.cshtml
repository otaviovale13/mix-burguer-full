@{
    ViewData["Title"] = "Home Page";
}

@{
    ViewData["LayoutType"] = "A";
}

<!-- Seção principal com background -->
<div class="container-dad d-flex flex-column justify-content-center text-start position-relative overflow-hidden w-100">
    <div class="texts ps-5 position-relative z-1 text-white">
        <h1 class="text-mix-burguer">MIX BURGUER</h1>
        <h1 class="text-mix">BURGER <br /> DE VERDADE</h1>
        <h1 class="text-chega">Chega rapidinho para matar sua fome!</h1>
        <button class="btn-menu" onclick="btnCardapio()">Fazer Pedido</button>
    </div>
</div>

<!-- Barra com logo -->
<div class="bar bg-mix d-flex justify-content-center position-relative py-5">
    <img class="slash-logo position-absolute top-50 start-50 translate-middle" src="./IMGS/Logo.png" alt="Logo" />
</div>

<!-- Seção "Quem Somos" -->
<section class="container-who position-relative text-white text-center py-5">
    <div class="container position-relative z-1">
        <div class="row align-items-center g-5">
            <div class="col-lg-6">
                <img class="img-fluid rounded photo" src="./IMGS/b29db971-6900-4316-813c-44d05d1df442.jpeg" alt="Foto da hamburgueria" />
            </div>
            <div class="conatiner-we-are col-lg-6">
                <div class="text-who p-5 rounded-5 bg-black bg-opacity-75 text-start">
                    <h1 class="who-we-are">Quem Somos</h1>
                    <p class="text-biografia">
                        A Mix Burguer nasceu com um propósito claro: oferecer hambúrgueres artesanais de qualidade, preparados com ingredientes frescos e saborosos. <br>
                        Localizada em Itupeva-SP, nossa hamburgueria é sinônimo de paixão pela gastronomia e compromisso com a satisfação de cada cliente. <br>
                        Acreditamos que um bom hambúrguer vai além do sabor, é sobre experiência, atendimento e dedicação em cada detalhe. <br>
                        Nosso cardápio foi criado para agradar a todos, desde quem busca um smash bem feito até aqueles que preferem uma refeição completa. <br>
                        Seja para um almoço rápido, um jantar especial ou um lanche no fim do dia, estamos aqui para garantir uma experiência deliciosa, com qualidade e preço justo. <br>
                        <strong>Mix Burguer – O sabor que conquista a cada mordida!</strong>
                    </p>
                </div>
            </div>
        </div>
    </div>
</section>

